--- /dev/null
+++ b/build.c
@@ -0,0 +1,96 @@
+/* Boost.MPI for Cabin: supplies the target `mpi`, the system's MPI
+ * library, version 2 of the standard or newer, through its C interface.
+ *
+ * MPI comes from the installation CABIN_SDK_MPI_DIR names, which is
+ * the Microsoft MPI SDK (`Include`, `Lib`) or an installation prefix
+ * (`include/mpi.h`, the shared `lib/libmpi`), and without it from pkg-config
+ * (`ompi-c`: Open MPI, whose first release with that module, 1.5,
+ * implements MPI 2.1), which an MSVC build cannot use. */
+#define _POSIX_C_SOURCE 200809L
+#define _CRT_SECURE_NO_WARNINGS
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef _WIN32
+#include <io.h>
+#define exists(path) (_access(path, 0) == 0)
+#else
+#include <unistd.h>
+#define exists(path) (access(path, F_OK) == 0)
+#endif
+
+/* The oldest MPI standard Boost.MPI is written for. */
+#define OLDEST_MPI 2
+
+static void fail(const char *format, ...) {
+    va_list args;
+    va_start(args, format);
+    fputs("boost-mpi: ", stderr);
+    vfprintf(stderr, format, args);
+    fputc('\n', stderr);
+    va_end(args);
+    exit(1);
+}
+
+static const char *need(const char *name) {
+    const char *value = getenv(name);
+    if (!value || !*value) fail("%s is not set", name);
+    return value;
+}
+
+static int is(const char *name, const char *value) { return strcmp(need(name), value) == 0; }
+
+/* `MPI_VERSION` of mpi.h in `include`. */
+static int headers_version(const char *include) {
+    char path[4096], line[512];
+    int version = 0;
+    FILE *file;
+    snprintf(path, sizeof path, "%s/mpi.h", include);
+    if (!(file = fopen(path, "r"))) fail("no MPI headers in %s (cannot read %s)", include, path);
+    while (fgets(line, sizeof line, file)) {
+        if (sscanf(line, " # define MPI_VERSION %d", &version) == 1) break;
+    }
+    fclose(file);
+    return version;
+}
+
+static void from_sdk(FILE *result, const char *sdk) {
+    char include[4096], library[4096];
+    /* The SDK has `x64` and `x86`; any other architecture finds no library. */
+    const char *arch = is("CABIN_TARGET_ARCH", "x86_64") ? "x64" : need("CABIN_TARGET_ARCH");
+    int version;
+    snprintf(include, sizeof include, "%s/Include", sdk);
+    snprintf(library, sizeof library, "%s/Lib/%s/msmpi.lib", sdk, arch);
+    if (!exists(library)) {
+        /* The shared library only: a static libmpi needs further libraries
+         * that only its own wrapper compiler names. */
+        snprintf(include, sizeof include, "%s/include", sdk);
+        snprintf(library, sizeof library, "%s/lib/libmpi.%s", sdk, is("CABIN_TARGET_OS", "macos") ? "dylib" : "so");
+        if (!exists(library))
+            fail("CABIN_SDK_MPI_DIR (%s) holds neither Lib/%s/msmpi.lib nor a shared lib/libmpi", sdk, arch);
+    }
+    version = headers_version(include);
+    if (version < OLDEST_MPI) fail("the MPI in CABIN_SDK_MPI_DIR (%s) is older than MPI %d", sdk, OLDEST_MPI);
+    fprintf(result, "external mpi\ninclude-dir mpi %s\nlink-file mpi %s\nrerun-if-changed %s/mpi.h\n", include,
+            library, include);
+}
+
+int main(void) {
+    const char *sdk = getenv("CABIN_SDK_MPI_DIR");
+    FILE *result = fopen(need("CABIN_RESULT_FILE"), "w");
+    if (!result) fail("cannot write the result file");
+    if (sdk && *sdk) {
+        from_sdk(result, sdk);
+    } else if (is("CABIN_TARGET_DIALECT", "msvc")) {
+        fail("an MSVC build takes MPI from a directory: set CABIN_SDK_MPI_DIR to the Microsoft MPI SDK "
+             "(the directory holding `Include` and `Lib`)");
+    } else {
+        fputs("external mpi\npkg-config mpi ompi-c >=1.5\n", result);
+    }
+    /* Only the C interface: as upstream's CMake does (MPI_CXX_SKIP_MPICXX),
+     * keep mpi.h from including the C++ bindings, a library of their own. */
+    fputs("interface-define mpi OMPI_SKIP_MPICXX\ninterface-define mpi MPICH_SKIP_MPICXX\n", result);
+    return fclose(result) != 0;
+}
