--- /dev/null
+++ b/lemon/config.h
@@ -0,0 +1,19 @@
+/* Stands in for the lemon/config.h CMake generates from config.h.in, with
+   every LP and MIP solver backend off, so LEMON_HAVE_LP, LEMON_HAVE_MIP,
+   the per-solver LEMON_HAVE_* macros and LEMON_DEFAULT_LP/MIP stay
+   undefined.  As CMake's Threads check does with MSVC and on Unix, LEMON
+   locks with Win32 threads on Windows and with pthreads elsewhere. */
+#define LEMON_VERSION "1.3.1"
+#define LEMON_HAVE_LONG_LONG 1
+
+#define _LEMON_CPLEX 1
+#define _LEMON_CLP 2
+#define _LEMON_GLPK 3
+#define _LEMON_SOPLEX 4
+#define _LEMON_CBC 5
+
+#ifdef _WIN32
+#define LEMON_USE_WIN32_THREADS 1
+#else
+#define LEMON_USE_PTHREAD 1
+#endif
