--- /dev/null
+++ b/parsers/include/trieste/json_export.h
@@ -0,0 +1,48 @@
+
+#ifndef JSON_EXPORT_H
+#define JSON_EXPORT_H
+
+#ifdef JSON_STATIC_DEFINE
+#  define JSON_EXPORT
+#  define JSON_NO_EXPORT
+#else
+#  ifndef JSON_EXPORT
+#    ifdef json_EXPORTS
+        /* We are building this library */
+#      define JSON_EXPORT 
+#    else
+        /* We are using this library */
+#      define JSON_EXPORT 
+#    endif
+#  endif
+
+#  ifndef JSON_NO_EXPORT
+#    define JSON_NO_EXPORT 
+#  endif
+#endif
+
+/* CMake writes __declspec(deprecated) where WIN32 is set. */
+#ifndef JSON_DEPRECATED
+#  ifdef _WIN32
+#    define JSON_DEPRECATED __declspec(deprecated)
+#  else
+#    define JSON_DEPRECATED __attribute__ ((__deprecated__))
+#  endif
+#endif
+
+#ifndef JSON_DEPRECATED_EXPORT
+#  define JSON_DEPRECATED_EXPORT JSON_EXPORT JSON_DEPRECATED
+#endif
+
+#ifndef JSON_DEPRECATED_NO_EXPORT
+#  define JSON_DEPRECATED_NO_EXPORT JSON_NO_EXPORT JSON_DEPRECATED
+#endif
+
+/* NOLINTNEXTLINE(readability-avoid-unconditional-preprocessor-if) */
+#if 0 /* DEFINE_NO_DEPRECATED */
+#  ifndef JSON_NO_DEPRECATED
+#    define JSON_NO_DEPRECATED
+#  endif
+#endif
+
+#endif /* JSON_EXPORT_H */
